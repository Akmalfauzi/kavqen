generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String? // nullable for google login
  name      String?
  phone     String?
  company   String?
  language  String @default("en")
  googleId  String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  authVersion Int @default(0)
  resetTokenHash String? @unique
  resetTokenExpiresAt DateTime?

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  ownedWorkflows Workflow[]  @relation("WorkflowOwner")
  createdCodes   AccessCode[] @relation("AccessCodeCreator")
  formGrants     FormGrant[]
  submissions    Submission[]
  knowledgeDocuments KnowledgeDocument[]
  notifications UserNotification[]
  googleCalendar GoogleCalendarConnection?
}

model UserNotification {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String
  kind        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model KnowledgeDocument {
  id        String    @id @default(uuid())
  ownerId   String
  title     String
  category  String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId, deletedAt])
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique
  description String
  color       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users       User[]
  permissions RolePermission[]
}

model PermissionGroup {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  permissions Permission[]
}

model Permission {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  groupId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  group PermissionGroup  @relation(fields: [groupId], references: [id])
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Field {
  id          String   @id @default(uuid())
  name        String   @unique
  label       String
  type        String
  required    Boolean  @default(false)
  prompt_hint String?
  options     String[]
  category    String?
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Agent {
  id             String   @id @default(uuid())
  name           String
  role           String
  themeId        String
  voice          String
  model          String
  workflowSteps  Int      @default(0)
  avatarGradient String
  description    String?
  tags           String[]
  isActive       Boolean  @default(true)

  workflow Workflow?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Workflow {
  id          String    @id @default(uuid())
  name        String
  description String?
  status      String    @default("DRAFT")
  data        Json?     @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  ownerId     String?
  agentId     String?   @unique

  owner       User? @relation("WorkflowOwner", fields: [ownerId], references: [id])
  agent       Agent? @relation(fields: [agentId], references: [id])
  submissions Submission[]
  accessCodes AccessCode[]
  grants      FormGrant[]

  @@index([ownerId])
}

model Submission {
  id         String   @id @default(uuid())
  workflowId String
  userId     String?
  agentName  String?
  data       Json
  createdAt  DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@index([workflowId, createdAt])
  @@index([userId])
}

model AccessCode {
  id          String    @id @default(uuid())
  workflowId  String
  createdById String
  inviteEmail String?
  inviteStatus String?
  codeHash    String    @unique
  prefix      String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workflow  Workflow @relation(fields: [workflowId], references: [id])
  createdBy User     @relation("AccessCodeCreator", fields: [createdById], references: [id])
  grants    FormGrant[]

  @@index([workflowId])
  @@index([inviteEmail])
}

model FormGrant {
  id           String   @id @default(uuid())
  userId       String
  workflowId   String
  accessCodeId String
  expiresAt    DateTime
  redeemedAt   DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  workflow   Workflow   @relation(fields: [workflowId], references: [id])
  accessCode AccessCode @relation(fields: [accessCodeId], references: [id])

  @@unique([userId, workflowId])
  @@index([workflowId])
}

model GoogleCalendarConnection {
  id           String    @id @default(uuid())
  userId       String    @unique
  googleEmail  String
  // AES-encrypted with ENCRYPTION_KEY; never returned to the client.
  refreshToken String
  accessToken  String?
  expiresAt    DateTime?
  scope        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id])
}
