PORT=3003
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
AI_SERVICE_URL=http://localhost:8001
JWT_SECRET=replace_with_random_secret
CLIENT_URL=http://localhost:3002
# Use the same Web application Client ID as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Google Calendar needs the authorization-code flow, so a client secret is required
# (sign-in alone does not). Create both in Google Cloud Console > Credentials, and
# register GOOGLE_REDIRECT_URI there as an Authorized redirect URI.
GOOGLE_CLIENT_SECRET=
GATEWAY_URL=http://localhost:3003
GOOGLE_REDIRECT_URI=http://localhost:3003/api/v1/integrations/google/callback
MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-google-app-password
MAIL_FROM=Kavqen <your-gmail-address@gmail.com>
# Local testing without sending email: MAIL_DRIVER=file (never in production).
# Messages are written to apps/gateway/.dev-mail when started from gateway.
