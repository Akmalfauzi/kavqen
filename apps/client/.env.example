# Google OAuth Web application Client ID; must match gateway GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Local API requests use the Next.js /gateway proxy by default.
GATEWAY_INTERNAL_URL=http://127.0.0.1:3003
# Browser-accessible Socket.IO gateway origin (use HTTPS in production).
NEXT_PUBLIC_SOCKET_URL=http://localhost:3003
