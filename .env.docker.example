# Copy to .env for Docker Compose. NEXT_PUBLIC_* values are embedded at build time.
# HTTP API requests use /gateway, proxied internally to gateway:3003.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3003
# Must match GOOGLE_CLIENT_ID in apps/gateway/.env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Must match gateway ENCRYPTION_KEY if you override the default.
NEXT_PUBLIC_ENCRYPTION_KEY=default-hackathon-key

# Public URLs used for password-reset links and Google Calendar callbacks.
CLIENT_URL=http://localhost:3002
GATEWAY_URL=http://localhost:3003
GOOGLE_REDIRECT_URI=http://localhost:3003/api/v1/integrations/google/callback

# For deployment, replace public URLs with HTTPS origins and rebuild the client.
# Set DATABASE_URL in apps/gateway/.env. For PostgreSQL on the Docker host,
# use host.docker.internal instead of localhost (or use your remote DB hostname).

# Private gateway-to-knowledge service token (generate with openssl rand -hex 32).
KNOWLEDGE_INTERNAL_TOKEN=
